# Copy to .env and fill in. .env is git-ignored.

# Riot developer key from https://developer.riotgames.com (development keys expire after 24h)
RIOT_API_KEY=

# Platform (league data) and regional (match data) routing for EUW
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Rate limits for a development key: 20 requests / 1s and 100 requests / 120s
RIOT_RATE_LIMITS=20:1,100:120

# Local SQL Server in Docker
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_SA_PASSWORD=
MSSQL_DATABASE=RiotMeta
