# Copy to .env and fill in. .env is git-ignored.

# Riot developer key from https://developer.riotgames.com (development keys expire after 24h)
RIOT_API_KEY=

# Platform (league data) and regional (match data) routing for EUW
RIOT_PLATFORM=euw1
RIOT_REGION=europe

# Rate limits for a development key: 20 requests / 1s and 100 requests / 120s.
# A production key allows 500 / 10s and 30,000 / 600s; scripts/collect.sh still caps intake at
# MAX_PER_HOUR matches an hour so the laptop isn't worked any harder.
RIOT_RATE_LIMITS=20:1,100:120

# Local store: the download queue and raw JSON (SQLite, git-ignored)
STORE_PATH=data/riot.sqlite

# BigQuery. Sign in once with `gcloud auth application-default login`. A sandbox project (no
# billing account) works: it gives 10 GB of storage and 1 TB of queries a month for free.
BQ_PROJECT=
BQ_LOCATION=EU
# Any single query that would scan more than this many GB fails instead of running.
BQ_MAX_GB_BILLED=20

# Matches to collect per patch (raw JSON about 60 KB of local disk each, fact rows about 30 KB
# of BigQuery storage each).
MATCHES_PER_PATCH=30000
# The site switches to a new patch, and the old patch's data is deleted, once the new patch
# has this many. It then keeps growing up to MATCHES_PER_PATCH.
MATCHES_TO_GO_LIVE=30000
# Keep collecting one patch (e.g. 16.19) past its release, ignoring newer patches. Leave empty to
# follow each new patch. Games are only taken from before the next patch started.
HOLD_PATCH=
